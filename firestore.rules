rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ADMINISTRATOR VERIFICATION
    // =========================================================================

    // Verify user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify user is reading/writing their own user-scoped document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify administrator privileges via custom auth claim OR Firestore lookup
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    // =========================================================================
    // 1. DEFAULT DENY ALL ACCESS
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. USER PROFILES (Matched strictly by uid or verified administrator)
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (
        !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || isAdmin()
      );
      allow update: if (isOwner(userId) && (
        !('isAdmin' in request.resource.data) ||
        request.resource.data.isAdmin == resource.data.isAdmin
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. PUBLIC READ CATALOG DATA (Products, Categories, CMS, Homepage, Reviews, Prices)
    // =========================================================================
    match /products/{productId} {
      allow read, write: if true;
    }

    match /prices/{priceId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /sections/{sectionId} {
      allow read, write: if true;
    }

    match /homepageSections/{sectionId} {
      allow read, write: if true;
    }

    match /cms/{docId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 4. ORDERS, TRANSACTIONS & WAITLIST
    // =========================================================================
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /waitlist/{waitlistId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 5. STRICT ADMIN-ONLY COLLECTIONS
    // =========================================================================
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    match /adminPaymentsConfig/{docId} {
      allow read, write: if isAdmin();
    }

    match /adminTransactions/{docId} {
      allow read, write: if isAdmin();
    }

    match /autoListQueue/{docId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}

